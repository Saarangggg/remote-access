# Desktop Agent Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Secrets (change these to strong random strings in production)
JWT_ACCESS_SECRET=remoteconnect_access_secret_change_me_in_production
JWT_REFRESH_SECRET=remoteconnect_refresh_secret_change_me_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Device Configuration (auto-generated on first run)
DEVICE_NAME=MyPC
DEVICE_ID=

# Cloudflare Tunnel / Custom Domains
USE_CLOUDFLARE_TUNNEL=true
CLOUDFLARED_PATH=cloudflared
CUSTOM_URL=

# Screen Capture
DEFAULT_FPS=15
DEFAULT_QUALITY=medium

# File Manager
MAX_UPLOAD_SIZE_MB=500
ALLOWED_ROOTS=Desktop,Downloads,Documents,Pictures,Videos

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SESSION_EXPIRY_DAYS=7
