# Desktop Agent Environment Configuration
PORT=9678
NODE_ENV=production

# JWT Secrets (Run "node generate-secrets.js" to populate these automatically with secure keys)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# User Login Setup (Customize these credentials for pairing)
AGENT_USER=
AGENT_PASSWORD=

# Device Configuration
DEVICE_NAME=DEVICE_NAME
DEVICE_ID=

# Private Service Domain Config
CUSTOM_URL=https://domain.com
USE_CLOUDFLARE_TUNNEL=false

# Screen Capture
DEFAULT_FPS=30
DEFAULT_QUALITY=high

# File Manager
MAX_UPLOAD_SIZE_MB=50000000

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
SESSION_EXPIRY_DAYS=7
